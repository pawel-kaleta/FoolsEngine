Shaders: 
    Vertex Shader: ../FoolsEngine/base_assets/shaders/Base3DVertex.glsl
    Tessellation Shader:
    Geometry Shader:
    Fragment Shader: ../FoolsEngine/base_assets/shaders/Base3DFragmentBlend.glsl
Uniforms Data Size: 36
Uniforms:
  - Name: u_AlphaCutOff
    Type: Float
    Count: 1
    DefaultValue:
      - 0.5
  - Name: u_ORMTexturePacking
    Type: Bool
    Count: 1
    DefaultValue:
      - true
Shader Texture Slots:
  - u_BaseColorMap
  - u_ORMMap
  - u_NormalMap
  - u_RoughnessMap
  - u_MetalnessMap
  - u_AOMap